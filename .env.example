# Copy to .env (git does not keep it; devenv reads it). A provider is on when both its lines are set.
# Each OAuth app's redirect URI: PUBLIC_URL/api/auth/<provider>/callback,
# in development e.g. http://localhost:5190/api/auth/google/callback

# the database (the default: devenv's Postgres)
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5192/electro

# the address the app is at (the redirect URIs, and Secure cookies when it is https)
# PUBLIC_URL=http://localhost:5190

# https://console.cloud.google.com/apis/credentials: OAuth client ID, "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://github.com/settings/developers: New OAuth App
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# https://entra.microsoft.com: App registrations, "Accounts in any organizational directory and personal Microsoft accounts"
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
