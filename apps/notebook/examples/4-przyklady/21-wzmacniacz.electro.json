      "id": "39947585",
      "type": "code",
      "source": "p = simulate(wzmacniacz, t=0.2, dt=2e-5)\nkoniec = p.t.index(next(t for t in p.t if t >= 0.195))\nwe, wy = p.V(\"we\")[koniec:], p.V(\"wy\")[koniec:]\nprint(f\"wzmocnienie ≈ {(max(wy) - min(wy)) / (max(we) - min(we)):.0f} razy\")\np.plot(\"V_we\", \"V_wy\")",
