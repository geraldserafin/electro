      "id": "39947585",
      "type": "code",
      "source": "p = wzmacniacz.simulate(until=0.2, dt=2e-5)\nkoniec = next(k for k, t in enumerate(p.t) if t >= 0.195)\nwe, wy = p(\"V_we\")[koniec:], p(\"V_wy\")[koniec:]\nprint(f\"wzmocnienie ≈ {(max(wy) - min(wy)) / (max(we) - min(we)):.0f} razy\")\nplot(p, \"V_we\", \"V_wy\")",
      "outputs": [
        {
