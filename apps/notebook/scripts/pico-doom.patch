+#if EMU_LCD
+// a frame goes out when one is rendered (and now and then anyway, for wipes and still screens) — unless
+// the last one is still going out; the emulator is slow, and every scanline sent costs it
+static bool emu_tick(repeating_timer_t *t) {
+    static int idle;
+    if (emu_line >= SCREENHEIGHT && (sem_available(&render_frame_ready) || ++idle >= 4)) {
+        idle = 0;
+        emu_frame++;
+        emu_which = 0;
+        emu_line = 0;
+        irq_set_pending(LOW_PRIO_IRQ);
+    }
+    return true;
+}
+#endif
