+#if EMU_LCD
+// Without scanvideo (whose PIO and DMA scan a VGA picture out): a timer on core 1 starts a frame,
+// and its scanlines are handed out one after another as scanvideo would, each sent to the LCD by DMA.
+#ifndef EMU_LCD_FPS
+#define EMU_LCD_FPS 30
+#endif
+#define EMU_LCD_DMA 10
+static scanvideo_scanline_buffer_t emu_buffers[2];
+static uint32_t emu_data[2][SCREENWIDTH / 2 + 8];
+static volatile uint32_t emu_frame;
+static volatile int emu_line = SCREENHEIGHT;
+static int emu_which;
+static scanvideo_scanline_buffer_t *emu_begin(void) {
+    if (emu_line >= SCREENHEIGHT) return NULL;
+    scanvideo_scanline_buffer_t *b = &emu_buffers[emu_which];
+    b->data = emu_data[emu_which];
+    b->data_max = count_of(emu_data[0]);
+    b->scanline_id = (emu_frame << 16) | emu_line;
+    return b;
+}
+#define scanvideo_begin_scanline_generation(block) emu_begin()
+#define scanvideo_begin_scanline_generation_linked(n, block) emu_begin()
+#define scanvideo_end_scanline_generation(b) (emu_line++)
+#endif
